// Rebuilds docs/demo (the GitHub Pages replay) from public/ and the real engine.
// Run: npx tsx scripts/build-demo.mts
// docs/demo/index.html is written by hand and is left alone.
import { cpSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import type { Probe } from "../src/checks.js";
import type { Fetched } from "../src/fetcher.js";
import { analyse, summarise, type Report } from "../src/report.js";

const root = fileURLToPath(new URL("..", import.meta.url));
const pub = `${root}public`;
const out = `${root}docs/demo`;
const SITE = "https://ship-check-peach.vercel.app";
mkdirSync(out, { recursive: true });

const rel = (s: string) => s.replaceAll('"/public/', '"').replaceAll("'/public/", "'").replaceAll('url("/public/', 'url("');
writeFileSync(`${out}/ds.css`, rel(readFileSync(`${pub}/ds.css`, "utf8")));
cpSync(`${pub}/bout.js`, `${out}/bout.js`);
cpSync(`${pub}/live.js`, `${out}/live.js`);
cpSync(`${pub}/qr.svg`, `${out}/qr.svg`);
cpSync(`${pub}/fonts`, `${out}/fonts`, { recursive: true });
writeFileSync(`${out}/design-system.html`, rel(readFileSync(`${pub}/design-system.html`, "utf8")));

// The two demo pages, through the real engine. The probe stands in for the network:
// the two things the losing page points at that do not exist answer 404.
const probe: Probe = async (url) => ({ status: /find-us|latte-art/.test(url) ? 404 : 200 });
async function sample(name: string): Promise<Report> {
  const page: Fetched = {
    status: 200,
    headers: { "content-type": "text/html" },
    body: readFileSync(`${pub}/demo/${name}.html`),
    finalUrl: `${SITE}/demo/${name}`,
    ms: 120,
    truncated: false,
  };
  const r = await analyse(page, [], probe);
  return { ...r, checked_at: "2026-11-11T14:49:57.000Z" };
}
const before = await sample("before");
const after = await sample("after");
writeFileSync(`${out}/samples.js`, `// Generated by scripts/build-demo.mts from the real engine. Do not edit.\nwindow.SAMPLES = ${JSON.stringify({ before, after }, null, 1)};\n`);

// The live screen, fed with the same two results instead of the store.
const cut = (s: string) => (s.length > 110 ? `${s.slice(0, 107)}...` : s);
function liveCheck(r: Report, name: string, at: string, receipt: string) {
  const s = summarise(r);
  return {
    at,
    amount: "0.60",
    receipt_id: receipt,
    name,
    host: new URL(SITE).host,
    ship: s.ship,
    works: s.works,
    copy: s.copy,
    look: s.look,
    top: {
      works: r.works.problems.filter((p) => p.serious).slice(0, 2).map((p) => cut(p.what)),
      copy: [...new Map(r.copy.flags.map((f) => [f.line, f])).values()].slice(0, 2).map((f) => cut(`${f.tell}: "${f.line}"`)),
      look: [...new Map(r.look.flags.map((f) => [f.tell, f])).values()].slice(0, 3).map((f) => cut(f.tell)),
    },
  };
}
const lost = liveCheck(before, "Bean There, before", "2026-11-11T14:49:57.000Z", "0xsample0000000000000000000000000000000000000000000000000000000001");
const won = liveCheck(after, "Bean There, after", "2026-11-11T14:48:12.000Z", "0xsample0000000000000000000000000000000000000000000000000000000002");
const feed = { checks: [lost, won], board: [won, lost] };
const stub = `<script>
// Replay: the feed is sample data from the real engine. Nothing is paid and nothing is fetched.
window.fetch = function () { return Promise.resolve({ json: function () { return Promise.resolve(${JSON.stringify(feed)}); } }); };
</script>
<script src="live.js"></script>
<script>document.getElementById("base").textContent = "${SITE}";</script>`;
let live = rel(readFileSync(`${pub}/live.html`, "utf8"));
live = live.replace('<script src="live.js"></script>', stub);
live = live.replace("<p><b>Get on the card:</b>", '<p><b>This is a replay with sample data.</b> The real screen is at <a href="' + SITE + '/live">' + new URL(SITE).host + "/live</a>. <b>Get on the card:</b>");
writeFileSync(`${out}/live.html`, live);
console.log("docs/demo rebuilt:", before.verdict, "|", after.verdict);
